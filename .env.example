# Copy to .env and replace every CHANGE_ME value before deployment.
POSTGRES_DB=logsight
POSTGRES_USER=logsight
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://logsight:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/logsight
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=Demo Tenant
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
BOOTSTRAP_INGESTION_KEY=CHANGE_ME_LONG_RANDOM_INGESTION_KEY
DEMO_A_ADMIN_EMAIL=admin@demoa.local
DEMO_A_ADMIN_PASSWORD=CHANGE_ME_DEMO_A_ADMIN_PASSWORD
DEMO_A_VIEWER_EMAIL=viewer@demoa.local
DEMO_A_VIEWER_PASSWORD=CHANGE_ME_DEMO_A_VIEWER_PASSWORD
DEMO_B_ADMIN_EMAIL=admin@demob.local
DEMO_B_ADMIN_PASSWORD=CHANGE_ME_DEMO_B_ADMIN_PASSWORD
DEMO_B_VIEWER_EMAIL=viewer@demob.local
DEMO_B_VIEWER_PASSWORD=CHANGE_ME_DEMO_B_VIEWER_PASSWORD
ACCESS_TOKEN_EXPIRE_MINUTES=60
RETENTION_DAYS=7
RETENTION_CHECK_INTERVAL_SECONDS=86400
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
SYSLOG_INGEST_URL=http://backend:8000/ingest
SYSLOG_INGESTION_KEY=CHANGE_ME_LONG_RANDOM_INGESTION_KEY
VITE_API_BASE_URL=http://localhost:8000
